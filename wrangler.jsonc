{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "playbeat-live",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "html_handling": "none",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "account_id": "268d70036461fa09d670d62be71cb78a",
  "kv_namespaces": [
    { "binding": "VOD_CACHE", "id": "da8ab0a7b441440ba0c734fe48b6ff47" }
  ],
  "vars": {},
  "workers_dev": true,
  "routes": [
    { "pattern": "playbeat.live", "custom_domain": true },
    { "pattern": "www.playbeat.live", "custom_domain": true }
  ]
}
